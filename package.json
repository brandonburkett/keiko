{
  "name": "keiko",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">= 24"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "run-p type-check build-only",
    "preview": "vite preview",
    "test:unit": "vitest run --environment jsdom --root src/",
    "test:watch": "vitest --environment jsdom --root src/",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "lint": "eslint .",
    "prettier:write": "prettier --write './**/*.{js,vue,css,scss}'",
    "prettier:check": "prettier -l './**/*.{js,vue,css,scss}'",
    "prepare": "husky",
    "pre-commit": "lint-staged -r"
  },
  "browserslist": [
    "defaults"
  ],
  "lint-staged": {
    "*.{ts,js,vue}": [
      "prettier --write",
      "eslint",
      "bash -c 'npm run type-check'"
    ],
    "*.{css,scss}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "pinia": "^3.0.4",
    "vue": "^3.5.40",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.10.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.2.0",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.5.23",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
