{
  "name": "keiko",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">= 24"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "npm run type-check && npm run build-only",
    "preview": "vite preview",
    "test:unit": "vitest run --environment jsdom --root src/",
    "test:watch": "vitest --environment jsdom --root src/",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "lint": "eslint .",
    "prettier:write": "prettier --write './**/*.{js,vue,css,scss}'",
    "prettier:check": "prettier -l './**/*.{js,vue,css,scss}'",
    "prepare": "husky",
    "pre-commit": "lint-staged -r"
  },
  "browserslist": [
    "defaults"
  ],
  "lint-staged": {
    "*.{ts,js,vue}": [
      "prettier --write",
      "eslint",
      "bash -c 'npm run type-check'"
    ],
    "*.{css,scss}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@vue/devtools-api": "^8.2.1",
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "overrides": {
    "js-beautify": "^2.0.3"
  }
}
